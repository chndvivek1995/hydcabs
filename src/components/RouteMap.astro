---
// Abstract Hyderabad route map: dots for hubs, animated dashed routes HITEC City → Gachibowli → Financial District, etc.
// Pure SVG + CSS animation (respects prefers-reduced-motion). Coordinates are stylised, not geographic.
const hubs = [
  { id: 'kukatpally', x: 110, y: 70, label: 'Kukatpally' },
  { id: 'miyapur', x: 40, y: 120, label: 'Miyapur' },
  { id: 'hitec', x: 230, y: 150, label: 'HITEC City', major: true },
  { id: 'madhapur', x: 300, y: 120, label: 'Madhapur' },
  { id: 'gachibowli', x: 190, y: 240, label: 'Gachibowli', major: true },
  { id: 'fd', x: 120, y: 320, label: 'Financial District', major: true },
  { id: 'kokapet', x: 60, y: 390, label: 'Kokapet' },
  { id: 'begumpet', x: 400, y: 60, label: 'Begumpet' },
  { id: 'banjara', x: 380, y: 200, label: 'Banjara Hills' },
  { id: 'uppal', x: 520, y: 150, label: 'Uppal' },
  { id: 'lbnagar', x: 500, y: 330, label: 'LB Nagar' },
  { id: 'rgia', x: 330, y: 440, label: 'RGIA Airport' },
];
const H = Object.fromEntries(hubs.map((h) => [h.id, h]));
const path = (a: string, b: string, bend = 0) => { const p = H[a], q = H[b]; const mx = (p.x + q.x) / 2 + bend, my = (p.y + q.y) / 2 - bend; return `M${p.x},${p.y} Q${mx},${my} ${q.x},${q.y}`; };
const routes = [
  { d: path('kukatpally', 'hitec', 20), c: 'brand', delay: '0s' },
  { d: path('miyapur', 'gachibowli', -30), c: 'accent', delay: '.4s' },
  { d: path('hitec', 'gachibowli', 25), c: 'brand', delay: '.2s' },
  { d: path('gachibowli', 'fd', -20), c: 'brand', delay: '.6s' },
  { d: path('fd', 'kokapet', 10), c: 'accent', delay: '.9s' },
  { d: path('begumpet', 'madhapur', -30), c: 'accent', delay: '.3s' },
  { d: path('madhapur', 'hitec', 0), c: 'accent', delay: '.5s' },
  { d: path('uppal', 'banjara', 40), c: 'accent', delay: '.7s' },
  { d: path('banjara', 'gachibowli', 30), c: 'accent', delay: '.8s' },
  { d: path('lbnagar', 'rgia', 30), c: 'accent', delay: '1s' },
  { d: path('gachibowli', 'rgia', -60), c: 'brand', delay: '1.1s' },
];
---
<svg viewBox="-40 0 650 480" class="h-auto w-full" role="img" aria-labelledby="rm-title rm-desc">
  <title id="rm-title">Stylised map of Hyderabad employee transport routes</title>
  <desc id="rm-desc">Animated route lines connecting Kukatpally, Miyapur, HITEC City, Madhapur, Gachibowli, Financial District, Kokapet, Begumpet, Banjara Hills, Uppal, LB Nagar and RGIA airport.</desc>
  <defs>
    <radialGradient id="rm-glow" cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="#FFC400" stop-opacity=".55"/><stop offset="1" stop-color="#FFC400" stop-opacity="0"/></radialGradient>
    <pattern id="rm-dots" width="22" height="22" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="#ffffff" fill-opacity=".12"/></pattern>
    <filter id="rm-blur"><feGaussianBlur stdDeviation="6"/></filter>
  </defs>
  <rect x="-40" width="650" height="480" fill="url(#rm-dots)"/>
  {/* ORR ring (stylised) */}
  <ellipse cx="290" cy="250" rx="268" ry="208" fill="none" stroke="#ffffff" stroke-opacity=".10" stroke-width="10"/>
  <ellipse cx="290" cy="250" rx="268" ry="208" fill="none" stroke="#ffffff" stroke-opacity=".25" stroke-width="1.5" stroke-dasharray="2 10"/>
  <text x="290" y="35" text-anchor="middle" fill="#ffffff" fill-opacity=".45" font-size="11" font-family="Inter, sans-serif" letter-spacing="3">OUTER RING ROAD</text>
  {/* routes */}
  {routes.map((r) => (
    <g>
      <path d={r.d} fill="none" stroke={r.c === 'brand' ? '#FFC400' : '#1E5BFF'} stroke-opacity=".25" stroke-width="6" stroke-linecap="round"/>
      <path d={r.d} fill="none" stroke={r.c === 'brand' ? '#FFC400' : '#6B8CFF'} stroke-width="2" stroke-linecap="round" class="route-dash" style={`animation-delay:${r.delay}`}/>
    </g>
  ))}
  {/* hubs */}
  {hubs.map((h) => (
    <g>
      {h.major && <circle cx={h.x} cy={h.y} r="26" fill="url(#rm-glow)" filter="url(#rm-blur)"/>}
      <circle cx={h.x} cy={h.y} r={h.major ? 9 : 6} fill={h.major ? '#FFC400' : '#ffffff'} fill-opacity={h.major ? 1 : .9} class={h.major ? 'pulse-dot' : ''} style={`animation-delay:${(h.x % 7) / 10}s`}/>
      <circle cx={h.x} cy={h.y} r={h.major ? 4 : 2.5} fill="#0B0F19"/>
      <text x={h.x + (h.id === 'fd' || h.id === 'kokapet' || h.id === 'miyapur' ? -12 : 14)} y={h.y + (h.id === 'fd' ? 24 : 4)} text-anchor={h.id === 'fd' || h.id === 'kokapet' || h.id === 'miyapur' ? 'end' : 'start'} fill="#ffffff" fill-opacity={h.major ? .95 : .7} font-size={h.major ? 13 : 11} font-weight={h.major ? 700 : 500} font-family="Inter, sans-serif">{h.label}</text>
    </g>
  ))}
  {/* live-trip chip */}
  <g transform="translate(372 362)">
    <rect width="176" height="58" rx="12" fill="#141a2a" stroke="#ffffff" stroke-opacity=".12"/>
    <circle cx="20" cy="29" r="6" fill="#12B76A" class="pulse-dot"/>
    <text x="36" y="25" fill="#ffffff" font-size="11" font-weight="700" font-family="Inter, sans-serif">Trip HC-0413 · on time</text>
    <text x="36" y="42" fill="#ffffff" fill-opacity=".6" font-size="10" font-family="Inter, sans-serif">Gachibowli → Kokapet · ETA 18 min</text>
  </g>
</svg>
