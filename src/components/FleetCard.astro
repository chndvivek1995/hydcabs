---
import Icon from './Icon.astro';
import type { Vehicle } from '../lib/data';
interface Props { v: Vehicle; detailed?: boolean }
const { v, detailed = false } = Astro.props;
---
<article class="card card-hover flex h-full flex-col gap-4">
  <div class="flex items-start justify-between gap-4">
    <span class="icon-tile"><Icon name={v.icon} size={22} /></span>
    <span class="chip !py-1 text-xs"><Icon name="users" size={13} /> {v.seats} seats</span>
  </div>
  <div>
    <h3 class="h3">{v.name}</h3>
    <p class="mt-0.5 text-sm text-slate">{v.examples}</p>
  </div>
  <p class="text-[15px] leading-relaxed text-ink/85">{v.bestFor}</p>
  {detailed && <p class="text-[15px] leading-relaxed text-slate">{v.notes}</p>}
  <dl class="mt-auto grid grid-cols-2 gap-2 border-t border-mist-200 pt-4 text-sm">
    <div><dt class="text-xs uppercase tracking-wide text-slate">Luggage</dt><dd class="font-medium">{v.luggage}</dd></div>
    <div><dt class="text-xs uppercase tracking-wide text-slate">Air-conditioned</dt><dd class="font-medium">{v.ac ? 'Yes' : 'No'}</dd></div>
  </dl>
  {detailed && <ul class="flex flex-wrap gap-1.5">{v.useCases.map((u) => <li class="rounded-md bg-mist px-2 py-1 text-xs font-medium text-slate">{u}</li>)}</ul>}
</article>
