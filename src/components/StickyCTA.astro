---
// Mobile sticky bottom bar: Call | WhatsApp | Get Quote — the #1 conversion driver in this niche.
import Icon from './Icon.astro';
import { SITE, telLink, waLink } from '../config/site';
interface Props { whatsapp?: string; quoteHref?: string }
const { whatsapp = 'Hi, I need corporate cab services in Hyderabad for our team.', quoteHref = '#quote' } = Astro.props;
---
<div class="fixed inset-x-0 bottom-0 z-40 border-t border-mist-200 bg-paper/95 pb-[env(safe-area-inset-bottom)] backdrop-blur-md md:hidden" id="sticky-cta">
  <div class="grid grid-cols-3 divide-x divide-mist-200 text-center text-xs font-bold">
    <a href={telLink} class="flex flex-col items-center gap-1 py-2.5 text-ink" data-track="sticky_call"><Icon name="phone" size={20} /> Call</a>
    <a href={waLink(whatsapp)} target="_blank" rel="noopener" class="flex flex-col items-center gap-1 py-2.5 text-success-700" data-track="sticky_whatsapp"><Icon name="message-circle" size={20} /> WhatsApp</a>
    <a href={quoteHref} class="flex flex-col items-center gap-1 bg-brand py-2.5 text-brand-ink" data-track="sticky_quote"><Icon name="file-check" size={20} /> Get Quote</a>
  </div>
</div>
<div class="h-16 md:hidden" aria-hidden="true"></div>
