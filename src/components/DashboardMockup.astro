---
// Illustrative admin dashboard UI with clearly fake demo data. Captioned "Sample dashboard".
import Icon from './Icon.astro';
const trips = [
  { id: 'HC-0412', route: 'Kukatpally → Mindspace', shift: '08:30', status: 'On time', s: 'ok' },
  { id: 'HC-0413', route: 'Gachibowli → Kokapet', shift: '09:00', status: 'En route', s: 'ok' },
  { id: 'HC-0419', route: 'Miyapur → Financial District', shift: '09:00', status: 'Delayed 6 min', s: 'warn' },
  { id: 'HC-0427', route: 'LB Nagar → Uppal', shift: '09:30', status: 'Boarding', s: 'ok' },
  { id: 'HC-0431', route: 'Secunderabad → Begumpet', shift: '09:30', status: 'Scheduled', s: 'muted' },
];
const bars = [62, 70, 58, 84, 76, 91, 88, 73, 95, 90, 86, 97];
---
<figure class="dark rounded-lg border border-white/12 bg-ink p-3 text-paper sm:p-4">
  <div class="rounded-md border border-white/10 p-4 sm:p-5">
    <div class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-2 text-sm font-semibold"><span class="font-ui text-[11px] uppercase tracking-[.2em] text-brand-300">Transport command desk</span></div>
      <span class="flex items-center gap-2 text-xs text-slate-400"><span class="size-2 rounded-full bg-brand pulse-dot"></span> Live · demo data</span>
    </div>
    <div class="mt-4 grid grid-cols-3 gap-2 text-center sm:gap-3">
      {[['Active trips', '48'], ['On-time today', '96%'], ['No-shows', '3']].map(([l, v]) => (
        <div class="rounded-md border border-white/10 p-3"><p class="font-display text-xl font-extrabold sm:text-2xl">{v}</p><p class="text-[11px] uppercase tracking-wide text-slate-400">{l}</p></div>
      ))}
    </div>
    <div class="mt-4 rounded-md border border-white/10 p-3">
      <div class="flex items-center justify-between text-xs text-slate-400"><span>On-time % · last 12 weeks</span><span>Target 95%</span></div>
      <div class="mt-3 flex h-16 items-end gap-1.5" aria-hidden="true">
        {bars.map((b) => <span class:list={['flex-1 rounded-t-sm', b >= 95 ? 'bg-brand' : 'bg-white/25']} style={`height:${b}%`}></span>)}
      </div>
    </div>
    <table class="mt-4 w-full text-left text-xs sm:text-sm">
      <thead class="text-[11px] uppercase tracking-wide text-slate-400"><tr><th class="py-1.5 pr-2 font-medium">Trip</th><th class="py-1.5 pr-2 font-medium">Route</th><th class="hidden py-1.5 pr-2 font-medium sm:table-cell">Shift</th><th class="py-1.5 font-medium">Status</th></tr></thead>
      <tbody class="divide-y divide-white/[.06]">
        {trips.map((t) => (
          <tr><td class="py-2 pr-2 font-mono text-[11px] text-slate-400">{t.id}</td><td class="py-2 pr-2 font-medium">{t.route}</td><td class="hidden py-2 pr-2 text-slate-400 sm:table-cell">{t.shift}</td>
          <td class="py-2"><span class:list={['inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-[11px] font-semibold', t.s === 'ok' && 'border border-brand/50 text-brand-300', t.s === 'warn' && 'border border-white/30 text-paper', t.s === 'muted' && 'bg-white/10 text-slate-400']}>{t.status}</span></td></tr>
        ))}
      </tbody>
    </table>
  </div>
  <figcaption class="mt-3 text-center text-xs text-slate-400">Sample dashboard — illustrative UI with demo data</figcaption>
</figure>
