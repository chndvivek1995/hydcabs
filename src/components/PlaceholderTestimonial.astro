---
// Renders real testimonials only (consent === true). Renders nothing until testimonials.json has entries.
import Icon from './Icon.astro';
import { testimonials } from '../lib/data';
---
{testimonials.length > 0 && (
<section class="section bg-mist" id="testimonials">
  <div class="wrap">
    <p class="eyebrow reveal">What clients say</p>
    <h2 class="h2 mt-3 reveal">Teams that commute with us</h2>
    <ul class="mt-10 grid gap-4 md:grid-cols-3">
      {testimonials.map((t) => (
        <li class="card flex h-full flex-col gap-4"><Icon name="quote" size={24} class="text-brand" /><blockquote class="text-[15px] leading-relaxed text-ink/90">{t.quote}</blockquote><p class="mt-auto text-sm"><strong>{t.name}</strong><br><span class="text-slate">{t.role}, {t.company}</span></p></li>
      ))}
    </ul>
  </div>
</section>
)}
