---
import Icon from './Icon.astro';
import RouteMap from './RouteMap.astro';
import { SITE, waLink, telLink } from '../config/site';
interface Props { eyebrow?: string; title: string; text: string; whatsapp?: string; quoteHref?: string; bullets?: string[] }
const { eyebrow = 'Corporate cab & employee transportation · Hyderabad', title, text, whatsapp = 'Hi, I need corporate cab services in Hyderabad for our team.', quoteHref = '#quote', bullets = ['Verified drivers, GPS on every trip', 'Day, rotating and 2 AM night shifts', 'One monthly invoice that matches the MIS'] } = Astro.props;
---
<section class="dark relative overflow-hidden bg-ink text-paper">
  <div class="wrap relative grid items-end gap-12 pb-16 pt-32 sm:pt-36 lg:grid-cols-[1.15fr_1fr] lg:pb-24 lg:pt-44">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="mt-7 max-w-[17ch] text-paper">{title}</h1>
      <p class="mt-7 max-w-xl text-[1.125rem] leading-relaxed text-slate-400 sm:text-xl">{text}</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href={quoteHref} class="btn btn-brand" data-track="hero_quote">Request a route study <Icon name="arrow-right" size={16} /></a>
        <a href={waLink(whatsapp)} class="btn btn-outline" target="_blank" rel="noopener" data-track="hero_whatsapp"><Icon name="message-circle" size={16} /> WhatsApp</a>
      </div>
      <ul class="mt-10 grid gap-x-8 gap-y-2 border-t border-white/12 pt-6 text-[14px] text-paper/85 sm:grid-cols-3">
        {bullets.map((b) => <li class="flex items-start gap-2.5"><span class="mt-[7px] inline-block h-px w-4 shrink-0 bg-brand"></span>{b}</li>)}
      </ul>
    </div>
    <div class="relative mx-auto w-full max-w-[560px] lg:max-w-none">
      <div class="rounded-lg border border-white/12 p-3 sm:p-4">
        <RouteMap />
        <div class="mt-3 flex items-center justify-between border-t border-white/10 pt-3 font-ui text-[11px] uppercase tracking-[.2em] text-slate-400"><span>Live routes · illustrative</span><a class="text-paper hover:text-brand-300" href={telLink} data-track="hero_call">Command desk {SITE.phoneDisplay}</a></div>
      </div>
    </div>
  </div>
</section>
