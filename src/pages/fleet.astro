---
import PageLayout from '../layouts/PageLayout.astro';
import FleetCard from '../components/FleetCard.astro';
import QuoteForm from '../components/QuoteForm.astro';
import CTASection from '../components/CTASection.astro';
import FAQ from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import PhotoBand from '../components/PhotoBand.astro';
import { photos } from '../data/images';
import { fleet } from '../lib/data';
import { breadcrumbs, faqPage } from '../lib/schema';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Fleet', path: '/fleet/' }];
const faqs = [
  { q: 'How do you decide which vehicle a route gets?', a: 'By occupancy and road access. We count the employees boarding in each pickup window, then choose the smallest vehicle that carries them comfortably and can turn in their lanes — a sedan for narrow colony roads, a tempo traveller for a metro-station shuttle, a bus for plant trunk routes. The mix is reviewed monthly against actual boarding data.' },
  { q: 'Are all vehicles commercially registered and insured?', a: 'Yes. Every vehicle on a corporate roster must hold a commercial (yellow-board) registration, valid fitness certificate, insurance, PUC and the applicable permit. Expiry dates are tracked centrally and a vehicle with a lapsed document is pulled from the roster until it is renewed.' },
  { q: 'Can we mix vehicle types in one contract?', a: 'Absolutely, and most programmes do. A typical IT-corridor contract runs sedans and SUVs for clubbed day routes, a dedicated MUV for the night team, and a tempo traveller shuttle from the nearest metro station. Each vehicle class is priced on its own line so the invoice stays transparent.' },
  { q: 'Do you have electric vehicles for employee transport?', a: 'We run electric sedans on short, predictable loops inside the IT corridor where depot charging between shifts is practical. Range and charging windows limit them on long ORR or outstation runs, so EV share is set route by route; see the electric cab page for how we plan it.' },
  { q: 'How old are the vehicles?', a: 'Vehicle age limits are written into the contract — typically a maximum model age at induction and at renewal — and vehicles are inspected for interior condition, AC performance, tyres and seat belts before joining a roster. Ask for the current fleet age profile when you request a quote.' },
];
---
<PageLayout title="Corporate Cab Fleet in Hyderabad" description="Our corporate cab fleet in Hyderabad: sedans, SUVs, Innova Crysta MUVs, 12 and 17-seater tempo travellers, mini buses, 40-seat buses and EV sedans." path="/fleet/" h1="Corporate cab fleet for Hyderabad employee transport" eyebrow="Fleet" intro="Every vehicle class we deploy, what it carries, and where it fits. The right mix is chosen per route from occupancy data, not from a fixed fleet." {crumbs} schema={[breadcrumbs(crumbs), faqPage(faqs)]} whatsapp="Hi, I'd like to know about your fleet for employee transport in Hyderabad.">
  <PhotoBand image={photos.fleet.src} alt={photos.fleet.alt} eyebrow="The fleet" title="Sized to the route, inspected before the shift" text="Sedans for colony lanes, SUVs and MUVs for clubbed corridor routes, tempo travellers for metro feeders, buses for plant trunk routes. Every vehicle is commercially registered and checked at the start of its roster day." caption="Depot inspection · dawn" />
  <section class="section-tight"><div class="wrap"><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{fleet.map((v) => <div id={v.slug} class="reveal"><FleetCard v={v} detailed /></div>)}</div></div></section>
  <section class="section bg-mist"><div class="wrap"><div class="max-w-2xl reveal"><p class="eyebrow">Specification summary</p><h2 class="h2 mt-3">Fleet at a glance</h2></div>
    <div class="card mt-8 !p-0 overflow-x-auto reveal"><table class="w-full text-left text-sm"><thead class="bg-mist text-xs uppercase tracking-wide text-slate"><tr><th class="px-5 py-3 font-semibold">Class</th><th class="px-4 py-3 font-semibold">Examples</th><th class="px-4 py-3 font-semibold">Seats</th><th class="px-4 py-3 font-semibold">Luggage</th><th class="px-4 py-3 font-semibold">AC</th><th class="px-4 py-3 font-semibold">Best use</th></tr></thead><tbody class="divide-y divide-mist-200">{fleet.map((v) => <tr><th scope="row" class="px-5 py-3 font-semibold">{v.name}</th><td class="px-4 py-3 text-slate">{v.examples}</td><td class="px-4 py-3">{v.seats}</td><td class="px-4 py-3 text-slate">{v.luggage}</td><td class="px-4 py-3">{v.ac ? 'Yes' : 'No'}</td><td class="px-4 py-3 text-slate">{v.useCases.join(', ')}</td></tr>)}</tbody></table></div>
  </div></section>
  <section class="section"><div class="wrap grid gap-10 lg:grid-cols-2 lg:items-start"><div class="prose-hc reveal"><h2>How the fleet is maintained</h2><p>Vehicles are cleaned between shifts and deep-cleaned on a fixed schedule; seat covers, floor mats and AC filters are on a replacement cycle rather than replaced when someone complains. Tyres, brakes and lights are checked at the start of every roster day and logged against the vehicle, so an issue raised by an employee can be traced to a specific inspection.</p><p>Documents — registration, fitness, insurance, PUC, permit and the driver's licence and badge — are tracked by expiry date. A vehicle with a lapsed document cannot be assigned to a trip until it is renewed, and the monthly MIS includes a compliance summary your admin team can file.</p><h2>Why we don't promise one fixed fleet</h2><p>Headcounts change, shifts move and projects end. A programme designed around a fixed number of vehicles either runs half-empty cabs or scrambles when a new batch joins. We size the fleet from the roster each week and price per vehicle-class, so the invoice scales with what actually ran. Dedicated-vehicle packages are available where a team genuinely needs a fixed car — see <a href="/pricing/">pricing</a> for both models.</p><p class="not-prose mt-6"><a href="/services/corporate-vehicle-leasing-hyderabad/" class="btn btn-outline">Vehicle leasing with driver <Icon name="arrow-right" size={16} /></a></p></div><div class="reveal reveal-d1"><QuoteForm title="Which vehicles would your routes need?" note="Tell us the headcount and pickup spread; we reply with a fleet mix and indicative pricing." whatsapp="Hi, I'd like a fleet proposal for employee transport in Hyderabad." /></div></div></section>
  <FAQ items={faqs} title="Fleet FAQs" />
  <CTASection />
</PageLayout>
