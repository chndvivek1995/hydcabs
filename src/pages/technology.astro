---
import PageLayout from '../layouts/PageLayout.astro';
import DashboardMockup from '../components/DashboardMockup.astro';
import QuoteForm from '../components/QuoteForm.astro';
import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';
import Icon from '../components/Icon.astro';
import PhotoBand from '../components/PhotoBand.astro';
import { photos } from '../data/images';
import { breadcrumbs, faqPage } from '../lib/schema';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Technology', path: '/technology/' }];
const wa = 'Hi, I want to see how your tracking and reporting works for employee transport in Hyderabad.';
const groups = [
  { icon: 'smartphone', title: 'For employees', items: ['Live ETA of the assigned cab', 'Driver and vehicle details before pickup', 'OTP or app-confirmed boarding', 'SOS button during the trip', 'Shift and pickup-time changes pushed, not phoned'] },
  { icon: 'layout-dashboard', title: 'For admin & HR', items: ['Weekly roster upload (spreadsheet or portal)', 'Auto-routing by corridor, shift and occupancy', 'Live map of all trips with exception flags', 'No-show, late-cancel and deviation logs', 'Monthly MIS that reconciles to the invoice'] },
  { icon: 'headset', title: 'For the command centre', items: ['Geofence alerts at pickup clusters and office gates', 'Breakdown and delay handling with replacement dispatch', 'Driver compliance and document expiry tracking', 'Escalation matrix per client', 'Incident log with closure notes'] },
];
const faqs = [
  { q: 'Do we need to install an app to use your service?', a: 'No. Employees can receive trip details and ETAs over SMS or WhatsApp if your company prefers not to roll out an app, and admins can work from spreadsheet rosters and emailed MIS. The app and portal add live tracking and self-service, but the programme runs either way.' },
  { q: 'Is the tracking platform your own software?', a: 'We run the programme on a GPS tracking and routing platform configured for each client, with our command desk operating it. We do not claim features we cannot show you; ask for a live demo during the route study and we will walk through exactly what your team will see.' },
  { q: 'How does automated routing reduce cost?', a: 'It clubs employees by corridor and shift so each vehicle runs fuller, sequences pickups to cut dead kilometres, and re-plans weekly as the roster changes. Fewer, fuller vehicles mean fewer trips to bill, and the MIS shows the occupancy so savings are visible rather than claimed.' },
  { q: 'What reports do we receive each month?', a: 'A standard pack: trips run, on-time percentage, no-shows and late cancellations, kilometres by route, exception and incident log, driver and vehicle compliance status, and a billing reconciliation that maps every invoice line to trips in the MIS. Custom cuts for finance or HR are available.' },
  { q: 'Can the data integrate with our HRMS or attendance system?', a: 'Rosters can be exported from most HRMS tools as a spreadsheet and uploaded directly, and MIS exports are provided as CSV for your finance or attendance systems. Direct API integration depends on your HRMS; we scope it during onboarding rather than promising it blindly.' },
];
---
<PageLayout title="GPS Cab Tracking & Employee Commute App" description="GPS cab tracking, live ETA, automated routing, roster upload, OTP boarding and monthly MIS for employee transport in Hyderabad. See how the platform works." path="/technology/" h1="GPS cab tracking, automated routing and MIS for employee transport" eyebrow="Technology" intro={['Transport that is tracked, routed and reported — so admin teams stop chasing drivers on the phone and finance stops arguing about the invoice.']} {crumbs} schema={[breadcrumbs(crumbs), faqPage(faqs)]} whatsapp={wa}>
  <section class="section-tight"><div class="wrap grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:items-center"><div class="reveal"><p class="eyebrow">The platform</p><h2 class="h2 mt-3">One view of every trip, for three audiences</h2><p class="lede">Employees see their cab. Admins see the programme. The command desk sees the exceptions and fixes them before anyone calls.</p><ul class="mt-6 space-y-2 text-[15px]">{['Live trip map with geofenced pickup clusters and office gates', 'Routes rebuilt weekly from the roster, not fixed for the contract', 'Every invoice line traceable to a trip in the MIS'].map((t) => <li class="flex gap-2"><span class="tick mt-1"><Icon name="check" size={12} /></span>{t}</li>)}</ul></div><div class="reveal reveal-d1"><DashboardMockup /></div></div></section>
  <PhotoBand flip image={photos.commandDesk.src} alt={photos.commandDesk.alt} eyebrow="Command centre" title="People watching the map, not just software" text="Geofence alerts, late drivers, breakdowns and route changes are handled by a desk that is awake through every shift, with an escalation matrix agreed with your admin team." caption="Transport command desk · night shift" />
  <section class="section bg-mist"><div class="wrap"><div class="max-w-2xl reveal"><p class="eyebrow">Capabilities</p><h2 class="h2 mt-3">What each group gets</h2></div><div class="mt-10 grid gap-4 md:grid-cols-3">{groups.map((g, i) => <div class:list={['card reveal', i && `reveal-d${i}`]}><span class="icon-tile"><Icon name={g.icon} size={22} /></span><h3 class="h3 mt-4">{g.title}</h3><ul class="mt-3 space-y-2 text-sm text-slate">{g.items.map((it) => <li class="flex gap-2"><span class="tick mt-0.5"><Icon name="check" size={11} /></span>{it}</li>)}</ul></div>)}</div></div></section>
  <section class="section"><div class="wrap grid gap-10 lg:grid-cols-2 lg:items-start"><div class="prose-hc reveal"><h2>How automated routing works on a Hyderabad roster</h2><p>Each week the roster arrives: who is working which shift, and where they live. The routing engine groups employees by corridor — the Kukatpally–Miyapur belt, the LB Nagar–Dilsukhnagar belt, Secunderabad and so on — then by shift, then sequences pickups so the vehicle moves towards the office rather than zig-zagging. Vehicle class is chosen from the headcount on each route.</p><p>The command desk reviews the output before it goes live, because software does not know that the Gachibowli flyover is closed for repairs or that a colony road in Manikonda cannot take a tempo traveller. The result is a route sheet with pickup windows, shared with employees the evening before.</p><h2>The monthly MIS and why it matters</h2><p>The MIS is where trust is built. On-time percentage, trips by route, kilometres, no-shows, late cancellations, incidents and compliance status — all drawn from the same tracking data the command desk used during the month. The invoice is generated from that data, so finance can check any line against a trip. Read <a href="/blog/sla-metrics-employee-transport/">which SLA metrics matter</a> and how to <a href="/blog/questions-before-signing-monthly-cab-contract/">write them into the contract</a>.</p></div><div class="reveal reveal-d1"><QuoteForm title="Book a platform walkthrough" note="We show your admin team the live dashboard and a sample MIS pack during the route study." whatsapp={wa} /></div></div></section>
  <FAQ items={faqs} title="Technology FAQs" />
  <CTASection whatsapp={wa} />
</PageLayout>
