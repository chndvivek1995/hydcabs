---
import PageLayout from '../../layouts/PageLayout.astro';
import Icon from '../../components/Icon.astro';
import PhotoBand from '../../components/PhotoBand.astro';
import { photos } from '../../data/images';
import QuoteForm from '../../components/QuoteForm.astro';
import CTASection from '../../components/CTASection.astro';
import { industries, solutions, url } from '../../lib/data';
import { breadcrumbs } from '../../lib/schema';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Industries', path: '/industries/' }];
---
<PageLayout title="Employee Transport by Industry" description="Employee transportation programmes for IT, BPO, pharma, hospitals, manufacturing and startups in Hyderabad, plus women-safety and cost-optimisation use cases." path="/industries/" h1="Employee transport for every industry in Hyderabad" eyebrow="Industries & use cases" intro="The shift pattern decides the transport model. These pages explain how we run programmes for each sector, and the use cases that cut across them." {crumbs} schema={[breadcrumbs(crumbs)]}>
  <section class="section-tight"><div class="wrap prose-hc max-w-3xl reveal"><h2>Why the industry matters for employee transport</h2><p>An IT services team in HITEC City, a BPO running US hours in Madhapur, a pharma plant in Genome Valley and a hospital in Banjara Hills all need employees moved on time, but almost nothing else about their transport is the same. Shift boundaries, the share of women on night rosters, the distance employees travel, whether the gate or the desk is the deadline, how often rosters change and how finance wants the bill cut all differ by sector. The pages below describe how we run programmes for each one, the shift patterns involved, and the Hyderabad areas where that industry clusters. The use-case pages cover problems that cut across industries: keeping women employees safe on night routes, reducing cost without cutting service, and moving plant workers on fixed shifts.</p><p>Whatever the sector, the same operating backbone applies: routes rebuilt weekly from your roster, verified drivers on GPS-tracked vehicles, a 24×7 command desk that handles exceptions, and a monthly MIS that the invoice reconciles to line by line. What changes by industry is the fleet mix — sedans and SUVs for clubbed IT-corridor routes, tempo travellers for metro feeders, buses for plant gates — the safety protocol around night work, and the service levels that matter most: desk time for an office, gate time for a plant, handover time for a hospital ward. Pricing follows the same logic; see <a href="/pricing/">how corporate cab rates are built</a> and the <a href="/fleet/">fleet page</a> for the vehicle classes behind each programme.</p></div></section>
  <section class="section-tight"><div class="wrap"><h2 class="h2 reveal">Industries</h2><ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{industries.map((i) => <li><a href={url.industry(i.slug)} class="card card-hover flex h-full flex-col gap-3 reveal"><span class="icon-tile"><Icon name={i.icon} size={22} /></span><span class="h3">{i.name}</span><span class="text-sm text-slate">{i.metaDescription}</span></a></li>)}</ul></div></section>
  <PhotoBand image={photos.plantShift.src} alt={photos.plantShift.alt} eyebrow="Plant & shift transport" title="Gate time is the only time that matters at a plant" text="A, B and C shifts at Balanagar, Jeedimetla, Patancheru and Genome Valley run on buses and tempo travellers with staged arrivals, so the 6 AM gate opens to a full line, not a trickle." cta={{ label: 'Factory shift transport', href: '/solutions/factory-shift-employee-transport-hyderabad/' }} caption="Shift change · industrial gate, Hyderabad outskirts" />
  <section class="section-tight bg-mist"><div class="wrap"><h2 class="h2 reveal">Use cases</h2><ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{solutions.map((s) => <li><a href={url.solution(s.slug)} class="card card-hover flex h-full flex-col gap-3 reveal"><span class="icon-tile"><Icon name={s.icon} size={22} /></span><span class="h3">{s.shortTitle}</span><span class="text-sm text-slate">{s.cardBlurb}</span></a></li>)}<li><a href="/services/night-shift-cab-hyderabad/" class="card card-hover flex h-full flex-col gap-3 reveal"><span class="icon-tile"><Icon name="moon" size={22} /></span><span class="h3">Night shift transport</span><span class="text-sm text-slate">Women-safety protocol, escorts and a command desk that works the US and UK shifts with you.</span></a></li></ul></div></section>
  <section class="section"><div class="wrap grid gap-10 lg:grid-cols-2 lg:items-center"><div class="reveal"><p class="eyebrow">Your sector not listed?</p><h2 class="h2 mt-3">Tell us the shift pattern; we will design the rest</h2><p class="lede">Retail, education, logistics, hospitality — if your people need to be somewhere at a fixed time, the same routing, safety and reporting apply.</p></div><div class="reveal reveal-d1"><QuoteForm /></div></div></section>
  <CTASection />
</PageLayout>
