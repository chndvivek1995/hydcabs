---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { SITE } from '../config/site';
import { url } from '../lib/data';
import { breadcrumbs, faqPage, blogPosting } from '../lib/schema';
import type { CollectionEntry } from 'astro:content';
interface Props { post: CollectionEntry<'blog'>; related: CollectionEntry<'blog'>[]; minutes: number }
const { post, related, minutes } = Astro.props;
const d = post.data;
const path = url.blog(post.id);
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog/' }, { name: d.title, path }];
const fmt = (x: Date) => x.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
const schema = [breadcrumbs(crumbs), faqPage(d.faqs), blogPosting({ path, title: d.title, description: d.description, published: d.pubDate, updated: d.updatedDate, author: d.author })];
const clusterLabel: Record<string, string> = { 'cost-pricing': 'Cost & pricing', 'vendor-selection': 'Vendor selection', 'safety-compliance': 'Safety & compliance', 'commute-guides': 'Hyderabad commute guides', 'operations-tech': 'Operations & tech', 'use-cases': 'Use cases', 'ev-sustainability': 'EV & sustainability', hr: 'HR & return to office' };
---
<BaseLayout title={d.title} description={d.description} {path} {schema} ogType="article" rawTitle>
  <article>
    <header class="dark relative overflow-hidden bg-ink text-paper">
      <div class="glow absolute inset-0" aria-hidden="true"></div><div class="grid-bg absolute inset-0 opacity-60 [mask-image:radial-gradient(ellipse_at_top,black_30%,transparent_80%)]" aria-hidden="true"></div>
      <div class="wrap relative pb-12 pt-10 sm:pb-16 sm:pt-12">
        <Breadcrumbs items={crumbs.slice(0, 2)} dark />
        <div class="mt-6 max-w-3xl">
          <p class="eyebrow">{clusterLabel[d.cluster] || d.cluster}</p>
          <h1 class="mt-3 text-paper !text-[clamp(1.9rem,4vw,3rem)]">{d.title}</h1>
          <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-400">{d.description}</p>
          <p class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-slate-400"><span class="flex items-center gap-1.5"><Icon name="user" size={14} /> {d.author}</span><span class="flex items-center gap-1.5"><Icon name="calendar-check" size={14} /> Updated <time datetime={(d.updatedDate || d.pubDate).toISOString()}>{fmt(d.updatedDate || d.pubDate)}</time></span><span class="flex items-center gap-1.5"><Icon name="clock" size={14} /> {minutes} min read</span></p>
        </div>
      </div>
    </header>
    <div class="wrap grid gap-12 py-12 lg:grid-cols-[minmax(0,2fr)_1fr] lg:py-16">
      <div>
        {d.needsVerification && <div class="mb-8 flex gap-3 rounded-2xl border border-brand/50 bg-brand/10 p-4 text-sm text-ink"><Icon name="alert-triangle" size={20} class="shrink-0 text-brand-600" /><p><strong>Verification note:</strong> this article discusses rules, taxes or regulations. Figures and legal positions must be checked against current official sources before you act on them; nothing here is legal or tax advice.</p></div>}
        <div class="prose-hc"><slot /></div>
        <div class="mt-12 rounded-2xl border border-mist-200 bg-mist p-6 text-sm"><p class="font-display font-bold">About the author</p><p class="mt-1 text-slate">Written by the {d.author} at {SITE.brand} — the people who plan routes, run the command desk and reconcile the monthly MIS for employee-transport programmes across Hyderabad.</p></div>
      </div>
      <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
        <QuoteForm title="Need this done for your team?" note="Share your roster and shifts; we reply with a plan and indicative pricing." />
        {related.length > 0 && <div class="card"><p class="eyebrow">Related reading</p><ul class="mt-4 space-y-3">{related.map((r) => <li><a href={url.blog(r.id)} class="font-semibold text-ink hover:text-accent-700">{r.data.title}</a></li>)}</ul></div>}
      </aside>
    </div>
    <FAQ items={d.faqs} compact title="Questions this article answers" />
  </article>
  <CTASection quoteHref="#quote" />
</BaseLayout>
